# --- Aplicação ---
APP_ENV=production
# Chave de criptografia das senhas de conexão (32 bytes em base64).
# Gerar com: php web/bin/gerar-chave.php
APP_KEY=

# --- Banco de controle (ReportService) ---
CONTROL_DB_SERVER=localhost
CONTROL_DB_NAME=ReportService
CONTROL_DB_USER=
CONTROL_DB_PASS=
# Use 1 apenas em ambientes com certificado autoassinado.
DB_TRUST_SERVER_CERT=0

# --- Resolução do cliente pela URL ---
# Primeiro grupo capturado = slug do cliente. Ex.: relatorio.campinas.elogica.info -> campinas
TENANT_HOST_REGEX=/^relatorio\.([a-z0-9-]+)\.elogica\.info$/

# --- Execução ---
QUERY_TIMEOUT=60

# --- Worker Python (metadados, IA, validação) ---
WORKER_URL=http://127.0.0.1:8001
WORKER_TOKEN=

# --- API de IA (somente metadados e agregados; nunca linhas reais) ---
ANTHROPIC_API_KEY=
AI_MODEL=
